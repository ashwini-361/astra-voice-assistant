# Copy to frontend/.env.local (Vite's convention) to override backend URLs.
# All default to native localhost ports if unset — no changes needed for
# today's `npm run dev` against `start_stack.ps1` or `make up`.
VITE_WHISPER_API_BASE=http://127.0.0.1:8001
VITE_LLM_API_BASE=http://127.0.0.1:8002
VITE_TTS_API_BASE=http://127.0.0.1:8003
VITE_INTENT_API_BASE=http://127.0.0.1:8004
VITE_DEV_MANAGER_API_BASE=http://127.0.0.1:3900
VITE_OLLAMA_API_BASE=http://127.0.0.1:11434
# Gateway (auth-only, PR1B — login/refresh/logout/me; not used for data-plane calls)
VITE_GATEWAY_API_BASE=http://127.0.0.1:8000
