# Copy this file to .env and adjust as needed. .env itself is gitignored.
#
# This one file works for BOTH native (start_stack.ps1) and Docker Compose
# use: docker-compose.yml overrides the *_HOST vars and a few others
# directly under each service's `environment:` block, which takes
# precedence over whatever is set here — so you don't need a second env
# file for containers.

# ── Service ports (same for native and container use) ──
AI_ASSISTANT_WHISPER_PORT=8001
AI_ASSISTANT_LLM_PORT=8002
AI_ASSISTANT_TTS_PORT=8003
AI_ASSISTANT_INTENT_PORT=8004

# ── Service hosts: leave as 127.0.0.1 for native `start_stack.ps1` use.
#    For `docker compose up` / `make up`, docker-compose.yml sets these
#    to the compose service names automatically — you do not need to
#    change these yourself for Docker. ──
AI_ASSISTANT_WHISPER_HOST=127.0.0.1
AI_ASSISTANT_LLM_HOST=127.0.0.1
AI_ASSISTANT_TTS_HOST=127.0.0.1
AI_ASSISTANT_INTENT_HOST=127.0.0.1

# ── Qdrant (vector memory store) ──
# Native: local Qdrant or file-mode fallback at ./qdrant_data.
# Docker Compose: overridden to http://qdrant:6333 automatically.
AI_ASSISTANT_QDRANT_URL=http://127.0.0.1:6333

# ── Postgres (Phase C — see docs/adr/ADR-007-multiuser-pivot.md) ──
# Native: point at 127.0.0.1. Docker Compose: overridden to
# postgresql+asyncpg://astra:astra@postgres:5432/astra automatically.
# users table added in PR1B; conversations/usage_counters land in PR2/PR3
# via Alembic (db/migrations/).
AI_ASSISTANT_POSTGRES_DSN=postgresql+asyncpg://astra:astra@127.0.0.1:5432/astra

# ── Gateway service (auth-only — see docs/api/gateway.md) ──
AI_ASSISTANT_GATEWAY_HOST=127.0.0.1
AI_ASSISTANT_GATEWAY_PORT=8000

# ── JWT (stateless access+refresh pair, no sessions/revocation table) ──
# CHANGE THIS SECRET before any real deployment.
AI_ASSISTANT_JWT_SECRET=change-me-in-.env
AI_ASSISTANT_JWT_ACCESS_EXPIRY_MINUTES=30
AI_ASSISTANT_JWT_REFRESH_EXPIRY_DAYS=30

# ── OAuth providers (Google/GitHub — see docs/adr/ADR-001-auth.md) ──
# Create OAuth apps at:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
# Redirect URI to register with each provider:
#   http://127.0.0.1:8000/api/v1/auth/callback/google
#   http://127.0.0.1:8000/api/v1/auth/callback/github
AI_ASSISTANT_OAUTH_GOOGLE_CLIENT_ID=
AI_ASSISTANT_OAUTH_GOOGLE_CLIENT_SECRET=
AI_ASSISTANT_OAUTH_GITHUB_CLIENT_ID=
AI_ASSISTANT_OAUTH_GITHUB_CLIENT_SECRET=
AI_ASSISTANT_OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000

# ── Redis (Phase C PR3 — see docs/adr/ADR-007-multiuser-pivot.md) ──
# Generic cache wrapper (core/cache.py): rate limiting is one consumer,
# not the only one. Native: point at 127.0.0.1. Docker Compose:
# overridden to redis://redis:6379/0 automatically.
AI_ASSISTANT_REDIS_URL=redis://127.0.0.1:6379/0

# ── Quotas & rate limiting (PR3) ──
AI_ASSISTANT_RATE_LIMIT_REQUESTS_PER_MINUTE=60
AI_ASSISTANT_QUOTA_MAX_REQUESTS_PER_MONTH=2000
AI_ASSISTANT_QUOTA_MAX_TOKENS_PER_MONTH=200000

# ── LLM provider ──
# Ollama stays native/external even when other services run in Docker
# (see docs/roadmap/ASTRA_WEB_SERVICE_PLAN.md) — make sure `ollama serve` is
# running and you've run `ollama pull qwen2.5:3b` before `make up`.
# Docker Compose overrides this URL to http://host.docker.internal:11434
# automatically for the llm container.
AI_ASSISTANT_LLM_PROVIDER=ollama
AI_ASSISTANT_OLLAMA_API_URL=http://127.0.0.1:11434
# Small local model — works offline after one `ollama pull`, no account
# needed. This is what `make smoke` is validated against on a clean clone.
AI_ASSISTANT_LLM_MODEL=qwen2.5:3b
# Cloud models on an Ollama Cloud account (swap LLM_MODEL, needs sign-in +
# network — clean-clone `make smoke` will fail until you've signed in):
#   AI_ASSISTANT_LLM_MODEL=gemma3:12b-cloud    # default persona quality tier
#   MCP tool calling : glm-4.7:cloud
#   Agent reasoning  : deepseek-v3.1:671b-cloud
#   Fast coding      : qwen3-coder:480b-cloud
#   Larger Gemma     : gemma3:27b-cloud

# Alternative providers (see core/config.py for all fields):
# AI_ASSISTANT_LLM_PROVIDER=openai
# AI_ASSISTANT_OPENAI_API_KEY=
# AI_ASSISTANT_OPENAI_API_URL=https://api.openai.com/v1
# AI_ASSISTANT_LLM_PROVIDER=lmstudio
# AI_ASSISTANT_LMSTUDIO_API_URL=http://127.0.0.1:1234
# AI_ASSISTANT_LLM_PROVIDER=custom
# AI_ASSISTANT_CUSTOM_LLM_API_URL=
# AI_ASSISTANT_CUSTOM_LLM_API_KEY=
# AI_ASSISTANT_CUSTOM_LLM_MODE=openai

# ── LLM generation tuning (defaults match core/config.py) ──
AI_ASSISTANT_LLM_NUM_PREDICT=300
AI_ASSISTANT_LLM_NUM_CTX=2048
AI_ASSISTANT_LLM_TEMPERATURE=0.7
AI_ASSISTANT_LLM_TOP_P=0.95

# ── Whisper ASR ──
# faster-whisper auto-downloads this model name from HuggingFace on first
# run (cached in HF_HOME / a Docker volume thereafter).
AI_ASSISTANT_WHISPER_MODEL_NAME=small

# ── Intent routing ──
# AI_ASSISTANT_INTENT_MODEL_PATH=models/intent.onnx

# ── TTS backend ──
# "edge" = Microsoft Edge TTS (default, no local server needed)
AI_ASSISTANT_TTS_BACKEND=edge
# Piper (used as the edge-offline fallback, or set TTS_BACKEND=piper directly):
# AI_ASSISTANT_PIPER_API_URL=http://127.0.0.1:59125
# AI_ASSISTANT_PIPER_VOICE=en_US-lessac-medium
# AI_ASSISTANT_PIPER_SPEAKER_ID=
# Fish-Speech (alternative TTS backend):
# AI_ASSISTANT_FISH_SPEECH_API_URL=http://127.0.0.1:8080
# Edge-TTS offline-detection tuning (used to decide when to fall back to Piper):
# AI_ASSISTANT_TTS_EDGE_OFFLINE_FALLBACK_ENABLED=True
# AI_ASSISTANT_TTS_EDGE_OFFLINE_CHECK_URL=https://www.microsoft.com
# AI_ASSISTANT_TTS_EDGE_OFFLINE_CHECK_TIMEOUT_SEC=0.5
# AI_ASSISTANT_TTS_EDGE_OFFLINE_STATE_TTL_SEC=3.0
# AI_ASSISTANT_TTS_EDGE_TIMEOUT_SEC=1.5

# ── Mic input device (native voice mode only, irrelevant in Docker) ──
# Empty = OS default. Some mic arrays silently deliver zero signal even
# though the stream opens without error — use select_mic_device.py to
# test and set this to a substring of the working device's name.
AI_ASSISTANT_MIC_DEVICE=

AI_ASSISTANT_LOG_LEVEL=INFO

# ── Dev Manager (native dev tool only — services/dev_manager.py) ──
# Not read from AI_ASSISTANT_* settings; consumed by the frontend directly.
# VITE_DEV_MANAGER_API_BASE=http://127.0.0.1:3900
