# Copy this file to .env and adjust as needed. .env itself is gitignored.
#
# This one file works for BOTH native (start_stack.ps1) and Docker Compose
# use: docker-compose.yml overrides the *_HOST vars and a few others
# directly under each service's `environment:` block, which takes
# precedence over whatever is set here — so you don't need a second env
# file for containers.

# ── Service ports (same for native and container use) ──
AI_ASSISTANT_WHISPER_PORT=8001
AI_ASSISTANT_LLM_PORT=8002
AI_ASSISTANT_TTS_PORT=8003
AI_ASSISTANT_INTENT_PORT=8004

# ── Service hosts: leave as 127.0.0.1 for native `start_stack.ps1` use.
#    For `docker compose up` / `make up`, docker-compose.yml sets these
#    to the compose service names automatically — you do not need to
#    change these yourself for Docker. ──
AI_ASSISTANT_WHISPER_HOST=127.0.0.1
AI_ASSISTANT_LLM_HOST=127.0.0.1
AI_ASSISTANT_TTS_HOST=127.0.0.1
AI_ASSISTANT_INTENT_HOST=127.0.0.1

# ── Qdrant (vector memory store) ──
# Native: local Qdrant or file-mode fallback at ./qdrant_data.
# Docker Compose: overridden to http://qdrant:6333 automatically.
AI_ASSISTANT_QDRANT_URL=http://127.0.0.1:6333

# ── LLM provider ──
# Ollama stays native/external even when other services run in Docker
# (see docs/ASTRA_WEB_SERVICE_PLAN.md) — make sure `ollama serve` is
# running before `make up`. Docker Compose overrides this URL to
# http://host.docker.internal:11434 automatically for the llm container.
AI_ASSISTANT_LLM_PROVIDER=ollama
AI_ASSISTANT_OLLAMA_API_URL=http://127.0.0.1:11434
AI_ASSISTANT_LLM_MODEL=gemma3:12b-cloud
# Other cloud models available on an Ollama Cloud account (swap LLM_MODEL):
#   MCP tool calling : glm-4.7:cloud
#   Agent reasoning  : deepseek-v3.1:671b-cloud
#   Fast coding      : qwen3-coder:480b-cloud
#   Larger Gemma     : gemma3:27b-cloud

# Alternative providers (see core/config.py for all fields):
# AI_ASSISTANT_LLM_PROVIDER=openai
# AI_ASSISTANT_OPENAI_API_KEY=
# AI_ASSISTANT_LLM_PROVIDER=lmstudio
# AI_ASSISTANT_LMSTUDIO_API_URL=http://127.0.0.1:1234
# AI_ASSISTANT_LLM_PROVIDER=custom
# AI_ASSISTANT_CUSTOM_LLM_API_URL=
# AI_ASSISTANT_CUSTOM_LLM_API_KEY=

# ── LLM generation tuning ──
AI_ASSISTANT_LLM_NUM_PREDICT=300
AI_ASSISTANT_LLM_NUM_CTX=4096
AI_ASSISTANT_LLM_TEMPERATURE=0.4
AI_ASSISTANT_LLM_TOP_P=0.95

# ── Whisper ASR ──
# faster-whisper auto-downloads this model name from HuggingFace on first
# run (cached in HF_HOME / a Docker volume thereafter).
AI_ASSISTANT_WHISPER_MODEL_NAME=small

# ── TTS backend ──
# "edge" = Microsoft Edge TTS (default, no local server needed)
AI_ASSISTANT_TTS_BACKEND=edge

# ── Mic input device (native voice mode only, irrelevant in Docker) ──
# Empty = OS default. Some mic arrays silently deliver zero signal even
# though the stream opens without error — use select_mic_device.py to
# test and set this to a substring of the working device's name.
AI_ASSISTANT_MIC_DEVICE=

AI_ASSISTANT_LOG_LEVEL=INFO
